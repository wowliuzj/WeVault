APP_NAME=WeVault
APP_ENV=production
API_V1_PREFIX=/api/v1
BACKEND_PORT=5726

# PostgreSQL is expected to run on the VPS host or an external database server.
# If PostgreSQL runs on the Docker host, use host.docker.internal on Docker Desktop,
# or run compose with host-gateway support if needed.
DATABASE_URL=postgresql+asyncpg://wevault:change-this-password@host.docker.internal:5432/wevault

SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_DISPLAY_NAME=Administrator
CLOUDFLARE_TURNSTILE_SECRET_KEY=

ASSET_STORAGE_DIR=/app/storage
EXPORT_FILE_TTL_DAYS=14
EXPORT_CLEANUP_INTERVAL_SECONDS=21600

WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2
WORKER_QUEUE=all
AUTO_FETCH_SCHEDULE_TIME=03:00
AUTO_FETCH_LOOKBACK_DAYS=2

WECHAT_BROWSER_HEADLESS=true
WECHAT_LOGIN_TIMEOUT_SECONDS=300
