APP_NAME=WeVault
APP_ENV=local
API_V1_PREFIX=/api/v1
BACKEND_PORT=5726
DATABASE_URL=postgresql+asyncpg://wevault:wevault@localhost:5432/wevault
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ASSET_STORAGE_DIR=storage
EXPORT_FILE_TTL_DAYS=14
EXPORT_CLEANUP_INTERVAL_SECONDS=21600
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_CONCURRENCY=2
WORKER_QUEUE=all
AUTO_FETCH_SCHEDULE_TIME=03:00
AUTO_FETCH_LOOKBACK_DAYS=2
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-admin-password
ADMIN_DISPLAY_NAME=Administrator
